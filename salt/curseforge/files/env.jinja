{%- set c = pillar['curseforge'] %}
# Single quotes kept on purpose: the key contains `$` (see the repo's
# .env.example).
CURSEFORGE_API_KEY='{{ c['api_key'] }}'
DJANGO_SECRET_KEY={{ c['django_secret_key'] }}
DJANGO_ALLOWED_HOSTS=repo.curseforge.bitt.app,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://repo.curseforge.bitt.app
