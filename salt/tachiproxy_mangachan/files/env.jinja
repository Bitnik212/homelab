{%- set m = pillar['tachiproxy_mangachan'] %}
DB_URL=jdbc:postgresql://postgres:5432/postgres
DB_USER=postgres
DB_PASSWORD={{ m['db_password'] }}

KTOR_LOG_LEVEL={{ m.get('ktor_log_level', 'INFO') }}
APP_ENV={{ m.get('app_env', 'production') }}

GRAYLOG_HTTP_INPUT_URL={{ m.get('graylog_http_input_url', 'https://http.input.graylog.bitt.app/gelf') }}

# vm-tachiproxy (proxmox-terraform/tachiproxy.tf); ports match its
# docker-compose.yml (proxy on 8070, api on 8100).
VERSION_PROXY_ENABLED=true
VERSION_PROXY_URL=http://{{ m['tachiproxy_host'] }}:8070
VERSION_PROXY_API_URL=http://{{ m['tachiproxy_host'] }}:8100/api/v1
VERSION_PROXY_CA_PATH=/app/ca.pem

{%- if m.get('s3_cache_enabled') %}
S3_CACHE_ENABLED=true
S3_CACHE_BUCKET={{ m.get('s3_cache_bucket', '') }}
S3_CACHE_ACCESS_KEY={{ m.get('s3_cache_access_key', '') }}
S3_CACHE_SECRET_KEY={{ m.get('s3_cache_secret_key', '') }}
S3_CACHE_ENDPOINT={{ m.get('s3_cache_endpoint', '') }}
S3_CACHE_REGION={{ m.get('s3_cache_region', 'us-east-1') }}
S3_CACHE_PUBLIC_BASE_URL={{ m.get('s3_cache_public_base_url', '') }}
S3_CACHE_KEY_PREFIX={{ m.get('s3_cache_key_prefix', '') }}
S3_CACHE_FORCE_PATH_STYLE={{ m.get('s3_cache_force_path_style', 'true') }}
{%- endif %}

{%- if m.get('proxyline_api_key') %}
PROXYLINE_API_KEY={{ m['proxyline_api_key'] }}
{%- endif %}
