include:
  - docker
  - tachiproxy_remanga.disk

tachiproxy_remanga_dir:
  file.directory:
    - name: /opt/tachiproxy-remanga
    - user: root
    - group: root
    - mode: '0750'
    - makedirs: True

# postgres's container runs as uid 70 (postgres:17-alpine); the data dir
# must be writable by it since docker doesn't chown bind mounts like it does
# named volumes.
tachiproxy_remanga_postgres_dir:
  file.directory:
    - name: /data/tachiproxy-remanga/postgres
    - user: 70
    - group: 70
    - mode: '0750'
    - makedirs: True
    - require:
      - mount: tachiproxy_remanga_data_mounted

tachiproxy_remanga_compose:
  file.managed:
    - name: /opt/tachiproxy-remanga/docker-compose.yml
    - source: salt://tachiproxy_remanga/files/docker-compose.yml
    - user: root
    - group: root
    - mode: '0644'
    - require:
      - file: tachiproxy_remanga_dir

tachiproxy_remanga_env:
  file.managed:
    - name: /opt/tachiproxy-remanga/.env
    - source: salt://tachiproxy_remanga/files/env.jinja
    - template: jinja
    - user: root
    - group: root
    - mode: '0600'
    - require:
      - file: tachiproxy_remanga_dir

# mitmproxy's CA (generated by vm-tachiproxy's proxy container), same file
# as tachiproxy_mangachan's -- see VERSION_PROXY_CA_PATH in files/env.jinja.
# World-readable since the images run as uid 10001, not root.
tachiproxy_remanga_ca:
  file.managed:
    - name: /opt/tachiproxy-remanga/ca.pem
    - source: salt://tachiproxy_remanga/files/ca.pem
    - user: root
    - group: root
    - mode: '0644'
    - require:
      - file: tachiproxy_remanga_dir

# Root-owned, not world/group-writable -- filebeat runs as root (see
# docker-compose.yml) and refuses to start against a config file it
# considers too permissive.
tachiproxy_remanga_filebeat_config:
  file.managed:
    - name: /opt/tachiproxy-remanga/filebeat.yml
    - source: salt://tachiproxy_remanga/files/filebeat.yml
    - user: root
    - group: root
    - mode: '0644'
    - require:
      - file: tachiproxy_remanga_dir

# api/worker track the floating `latest` tag, so pull explicitly on every
# apply -- `docker compose up -d` alone won't fetch a new image for a tag it
# already has locally.
tachiproxy_remanga_pull:
  cmd.run:
    - name: docker compose pull api worker
    - cwd: /opt/tachiproxy-remanga
    - require:
      - service: docker_service
      - file: tachiproxy_remanga_compose
      - file: tachiproxy_remanga_env

tachiproxy_remanga_up:
  cmd.run:
    - name: docker compose up -d
    - cwd: /opt/tachiproxy-remanga
    - require:
      - service: docker_service
      - file: tachiproxy_remanga_compose
      - file: tachiproxy_remanga_env
      - file: tachiproxy_remanga_ca
      - file: tachiproxy_remanga_filebeat_config
      - file: tachiproxy_remanga_postgres_dir
      - cmd: tachiproxy_remanga_pull

# filebeat.yml is bind-mounted (docker-compose.yml), so editing its content
# alone doesn't make `docker compose up -d` above recreate the container --
# restart it explicitly whenever the file actually changes.
tachiproxy_remanga_filebeat_restart:
  cmd.run:
    - name: docker compose restart filebeat
    - cwd: /opt/tachiproxy-remanga
    - onchanges:
      - file: tachiproxy_remanga_filebeat_config
    - require:
      - cmd: tachiproxy_remanga_up
