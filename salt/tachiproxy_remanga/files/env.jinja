{%- set m = pillar['tachiproxy_remanga'] %}
DB_URL=jdbc:postgresql://postgres:5432/postgres
DB_USER=postgres
DB_PASSWORD={{ m['db_password'] }}

APP_ENV={{ m.get('app_env', 'production') }}

GRAYLOG_HTTP_INPUT_URL={{ m.get('graylog_http_input_url', 'https://http.input.graylog.bitt.app/gelf') }}
{%- if m.get('source_client_log_level') %}
SOURCE_CLIENT_LOG_LEVEL={{ m['source_client_log_level'] }}
{%- endif %}
{%- if m.get('source_request_interval_millis') %}
SOURCE_REQUEST_INTERVAL_MILLIS={{ m['source_request_interval_millis'] }}
{%- endif %}

# vm-tachiproxy (proxmox-terraform/tachiproxy.tf); ports match its
# docker-compose.yml (proxy on 8070, api on 8100).
VERSION_PROXY_ENABLED=true
VERSION_PROXY_URL=http://{{ m['tachiproxy_host'] }}:8070
VERSION_PROXY_API_URL=http://{{ m['tachiproxy_host'] }}:8100/api/v1
VERSION_PROXY_CA_PATH=/app/ca.pem

# vm-elk's Elasticsearch -- filebeat (docker-compose.yml) ships this host's
# container logs there as the filebeat_writer_remanga user
# (salt/elk/app.sls creates it, scoped to only tachiproxy-remanga-logs-*).
ELK_HOST={{ pillar['elk']['host'] }}
ELK_FILEBEAT_PASSWORD={{ pillar['elk']['filebeat_writer_password'] }}
