{%- set p = pillar['packdrop'] %}
SECRET_KEY={{ p['secret_key'] }}
ALLOWED_HOSTS=packdrop.bitt.app
PACKDROP_PUBLIC_URL=https://packdrop.bitt.app

# TLS ends at vm-vpn's Caddy, but router-1's nginx in between overwrites
# X-Forwarded-Proto with its own $scheme (http) -- see
# salt/router/files/nginx-proxy.conf.jinja. Trusting that header would make
# SECURE_SSL_REDIRECT loop forever, so leave it off; Caddy already does the
# http->https redirect, and CSRF_TRUSTED_ORIGINS defaults to
# PACKDROP_PUBLIC_URL so https form posts still pass.
BEHIND_HTTPS_PROXY=0

CURSEFORGE_API_URL=https://repo.curseforge.bitt.app

# Mail.ru SMTP (SSL, port 465)
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=1
EMAIL_USE_TLS=0
EMAIL_HOST_USER={{ p['email_host_user'] }}
EMAIL_HOST_PASSWORD={{ p['email_host_password'] }}
DEFAULT_FROM_EMAIL={{ p['default_from_email'] }}
