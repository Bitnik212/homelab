{%- set r = pillar['myreels']['reels_api'] %}
{%- set db = pillar['myreels']['db'] %}
PROXYLINE_API_KEY={{ r['proxyline_api_key'] }}
S3_ACCESS_KEY={{ r['s3_access_key'] }}
S3_BUCKET={{ r['s3_bucket'] }}
S3_ENDPOINT_URL={{ r['s3_endpoint_url'] }}
S3_SECRET_KEY={{ r['s3_secret_key'] }}
KTOR_LOG_LEVEL={{ r['ktor_log_level'] }}

DB_URL={{ r['db_url'] }}
