#!/usr/bin/env bash
set -u

# Verifies router-1's public egress IP is still the xray server's (i.e.
# traffic is actually leaving via sing-box -> xray, not plain WAN) and
# restarts xray-client + sing-box if it's drifted. Run every 5 min via
# cron (router.publicip_check). Templated so EXPECTED_IP tracks pillar.
#
# Leaves a deliberately stopped sing-box alone (manual stop, or
# router.singbox's rollback timer firing) -- restarting it here would
# defeat that rollback within 5 minutes.

{%- set xr = pillar.get('router', {}).get('xray', {}) %}

EXPECTED_IP="{{ xr.get('expected_egress_ip') or xr.get('server_ip', '') }}"

# Must be a non-RU service: with router:singbox:direct_ru on, a RU-hosted
# checker (the old 2ip.io) is routed direct and always reports WAN's IP.
CHECK_URL="https://ifconfig.me"

ts() { date '+%Y-%m-%d %H:%M:%S'; }

if ! systemctl is-active --quiet sing-box; then
    echo "$(ts) sing-box is not active, skipping check."
    exit 0
fi

current_ip="$(curl -4 -fsS --max-time 10 "$CHECK_URL" | tr -d '[:space:]')"

if [[ -z "$current_ip" ]]; then
    echo "$(ts) ERROR: Failed to get public IP from $CHECK_URL"
    exit 1
fi

echo "$(ts) Current IP: $current_ip"

if [[ "$current_ip" != "$EXPECTED_IP" ]]; then
    echo "$(ts) Expected $EXPECTED_IP, got $current_ip. Restarting xray-client and sing-box..."
    systemctl restart xray-client
    systemctl restart sing-box
else
    echo "$(ts) IP is correct. Nothing to do."
fi
