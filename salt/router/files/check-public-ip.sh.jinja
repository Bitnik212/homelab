#!/usr/bin/env bash
set -u

# Verifies router-1's public egress IP is still the AWG server's (i.e.
# traffic is actually leaving via sing-box -> wg0, not plain WAN) and
# restarts awg-quick@wg0 + sing-box if it's drifted. Run every 5 min via
# cron (router.publicip_check). Templated so EXPECTED_IP tracks pillar.
#
# Leaves a deliberately stopped sing-box alone (manual stop, or
# router.singbox's rollback timer firing) -- restarting it here would
# defeat that rollback within 5 minutes.

{%- set awg = pillar.get('router', {}).get('amneziawg', {}) %}

EXPECTED_IP="{{ awg.get('expected_egress_ip') or awg.get('endpoint', '').rpartition(':')[0] }}"

# Must be non-RU services: with router:singbox:direct_ru on, a RU-hosted
# checker (the old 2ip.io) is routed direct and always reports WAN's IP.
# Several, so one checker being down doesn't read as a dead tunnel.
CHECK_URLS=("https://ifconfig.me" "https://api.ipify.org" "https://icanhazip.com")

ts() { date '+%Y-%m-%d %H:%M:%S'; }

restart_tunnel() {
    systemctl restart awg-quick@wg0
    systemctl restart sing-box
}

if ! systemctl is-active --quiet sing-box; then
    echo "$(ts) sing-box is not active, skipping check."
    exit 0
fi

current_ip=""
for url in "${CHECK_URLS[@]}"; do
    candidate="$(curl -4 -fsS --max-time 10 "$url" | tr -d '[:space:]')"
    if [[ "$candidate" =~ ^[0-9]+(\.[0-9]+){3}$ ]]; then
        current_ip="$candidate"
        break
    fi
    echo "$(ts) WARN: No usable answer from $url"
done

# Egress through the tunnel being dead looks exactly like this -- a stalled
# tunnel never drifts to WAN's IP, it just stops answering.
if [[ -z "$current_ip" ]]; then
    echo "$(ts) ERROR: No checker answered. Restarting awg-quick@wg0 and sing-box..."
    restart_tunnel
    exit 1
fi

echo "$(ts) Current IP: $current_ip"

if [[ "$current_ip" != "$EXPECTED_IP" ]]; then
    echo "$(ts) Expected $EXPECTED_IP, got $current_ip. Restarting awg-quick@wg0 and sing-box..."
    restart_tunnel
else
    echo "$(ts) IP is correct. Nothing to do."
fi
