[Unit]
Description=Policy route default egress via wg0 (tachiproxy split-tunnel)
After=network-online.target awg-quick@wg0.service docker.service
Wants=network-online.target
Requires=awg-quick@wg0.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/tachiproxy-split-tunnel.sh
RemainAfterExit=true

[Install]
WantedBy=multi-user.target
