{%- set st = pillar.get('tachiproxy', {}).get('splittunnel', {}) -%}
#!/usr/bin/env bash
set -euo pipefail

# === Full tunnel by default via wg0, LAN/docker/local kept off it ===
# Same policy-routing shape as router-1's split-tunnel.sh (table "vpn",
# default via wg0, WG endpoint pinned to WAN to avoid recursion, explicit
# exceptions so local/Salt traffic doesn't get swept into the tunnel-by-
# default table) -- minus router's RU-ipset split. That's a router-1-
# specific bypass with no equivalent need here: this box has no WAN-facing
# interface to protect (just one LAN NIC), and the whole point of this
# tunnel is that the ISP blocks HTTP proxy connections outright, so
# everything but local/management traffic should go through it.

WAN_IF="{{ st.get('wan_if', '') }}"
WAN_GW="{{ st.get('wan_gw', '') }}"
WG_IF="wg0"
WG_ENDPOINT="{{ st.get('wg_endpoint_ip', '') }}"
# Local/management subnet that must never be swept into the tunnel-by-
# default table -- without this, anything not explicitly excepted
# (including this box's own Salt control channel) gets routed via wg0.
LAN_CIDR="{{ st.get('lan_cidr', '') }}"

TABLE_NAME="vpn"
TABLE_ID="200"

ensure_rt_table() {
  local rt="/etc/iproute2/rt_tables"
  grep -Eq "^[[:space:]]*${TABLE_ID}[[:space:]]+${TABLE_NAME}[[:space:]]*$" "$rt" || \
    echo "${TABLE_ID} ${TABLE_NAME}" >> "$rt"
}

# ip rule add is not idempotent (duplicate add fails "File exists", which
# aborts under set -e) -- this runs on every boot.
add_rule_idem() {
  local pref="$1"; shift
  ip rule del pref "$pref" >/dev/null 2>&1 || true
  ip rule add pref "$pref" "$@"
}

ensure_rt_table

# Table vpn: default via wg0
ip route replace default dev "$WG_IF" table "$TABLE_NAME"

# Ensure the WireGuard endpoint ALWAYS goes via WAN (avoid recursion --
# without this, the tunnel would try to route its own handshake packets
# through itself once the catch-all rule below is in place).
ip route replace "${WG_ENDPOINT}/32" via "$WAN_GW" dev "$WAN_IF"

add_rule_idem 40 to 172.16.0.0/12 lookup main # docker net fix
add_rule_idem 41 to 127.0.0.0/8 lookup main # docker net fix

if [[ -n "$LAN_CIDR" ]]; then
  add_rule_idem 45 to "$LAN_CIDR" lookup main # keep local/management traffic (incl. Salt) off the tunnel
fi

add_rule_idem 50 to "${WG_ENDPOINT}/32" lookup main
add_rule_idem 200 lookup "$TABLE_NAME"

ip route flush cache
