{%- set t = pillar['tachiproxy'] %}
DATABASE_URL=postgresql+asyncpg://proxy:{{ t['db_password'] }}@postgres/proxy
DB_PASSWORD={{ t['db_password'] }}

PAYLOAD_STORAGE_ROOT=/data/payloads
GEOIP_DATABASE_PATH=/data/geoip/country.mmdb
MITMPROXY_CONFDIR=/data/mitmproxy

PROXY_LISTEN_HOST=0.0.0.0
PROXY_LISTEN_PORT=8080
API_LISTEN_HOST=0.0.0.0
API_LISTEN_PORT=8000

# Only the API container honours this; the proxy never migrates.
RUN_MIGRATIONS_ON_STARTUP=true
RUN_SCHEDULED_JOBS=true

API_TOKEN={{ t['api_token'] }}

MAX_UPSTREAM_ATTEMPTS=3
DEDUPLICATE_REVISIONS=true

PROXY_PROVIDER={{ t.get('proxy_provider', 'version_proxy.providers.static_provider:StaticProxyProvider') }}
PROXY_PROVIDER_OPTIONS={{ t.get('proxy_provider_options', '{"urls": []}') }}
PROXY_PROVIDER_SYNC_MISSING_POLICY=disable

EGRESS_IP_DISCOVERY_URL=https://api.ipify.org
SESSION_TTL_SECONDS=86400
LOG_LEVEL=INFO
