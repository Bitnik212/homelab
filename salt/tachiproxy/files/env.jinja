{%- set t = pillar['tachiproxy'] %}
DATABASE_URL=postgresql+asyncpg://proxy:{{ t['db_password'] }}@postgres/proxy
# docker-compose.yml's postgres service reads this for $DB_PASSWORD
# interpolation (must match the password in DATABASE_URL above).
DB_PASSWORD={{ t['db_password'] }}

PAYLOAD_STORAGE_ROOT=/data/version-proxy/payloads

PROXY_LISTEN_HOST=0.0.0.0
PROXY_LISTEN_PORT=8080

API_LISTEN_HOST=0.0.0.0
API_LISTEN_PORT=8000
{%- if t.get('api_token') %}
API_TOKEN={{ t['api_token'] }}
{%- else %}
# API_TOKEN=change-me
{%- endif %}

MAX_UPSTREAM_ATTEMPTS=3

PROXY_PROVIDER={{ t.get('proxy_provider', 'version_proxy.providers.static_provider:StaticProxyProvider') }}
{%- if t.get('proxyline_api_key') %}
PROXYLINE_API_KEY={{ t['proxyline_api_key'] }}
{%- endif %}
PROXY_PROVIDER_OPTIONS={{ t.get('proxy_provider_options', '{"urls": []}') }}
PROXY_PROVIDER_SYNC_MISSING_POLICY=disable

GEOIP_DATABASE_PATH=/data/geoip/GeoLite2-Country.mmdb
EGRESS_IP_DISCOVERY_URL=https://api.ipify.org

SESSION_TTL_SECONDS=86400

LOG_LEVEL=INFO

# Not part of the app's documented env vars, but keeping it pinned here is
# what makes mitmproxy write its CA into the persisted /data/mitmproxy
# volume instead of an ephemeral default -- removing it would rotate the
# CA and break mangachan's already-configured trust in it
# (salt/tachiproxy_mangachan/files/ca.pem).
MITMPROXY_CONFDIR=/data/mitmproxy
